# Same-origin deploy: leave both unset and relative paths are used.
#
# Split deploy (static frontend + API on another host) - set this to the
# backend origin. The WebSocket URL is derived from it automatically.
VITE_API_URL=https://your-backend.up.railway.app

# Only needed if the WebSocket lives somewhere other than the API.
# VITE_WS_URL=wss://your-backend.up.railway.app
